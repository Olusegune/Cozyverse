{
  "name": "cozyverse-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cozyverse Studio — a local-first creator app for building private-heaven digital art worlds.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "build:win": "npm run tauri build -- --bundles nsis,msi",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.0"
  }
}

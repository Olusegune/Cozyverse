{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cozyverse Studio",
  "version": "0.2.0",
  "identifier": "com.wheelbarrowstudios.cozyversestudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cozyverse Studio",
        "width": 1540,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/Cozyverses/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNERGRTVFQUI3MDY2RDMKUldUVFpuQ3JYdjVOejRweG9DRHVLNlJrYmJqYldHdGVCU2xja0FNUVFSOHhHWkRvTC9zM1AvWUUK",
      "endpoints": ["https://github.com/Olusegune/Cozyverse/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../decompose_pipeline.py": "decompose_pipeline.py",
      "../clip_rerank.py": "clip_rerank.py"
    },
    "shortDescription": "Create private-heaven digital art worlds",
    "longDescription": "Cozyverse Studio is a local-first creator app for building small, immersive Cozyverse worlds — artwork, motion, audio, and interactive scenes.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
